{%- from "partials/icons.njk" import icon -%}
<section class="cta">
  <div class="container cta__inner">
    <div>
      <p class="eyebrow eyebrow--light">Start a conversation</p>
      <h2 class="cta__title">{{ ctaTitle or "Planning a new kitchen or piece of furniture?" }}</h2>
      <p>Tell Joel a little about the room and what you have in mind. Photos and rough measurements are helpful, but a short description is a fine place to start. Every enquiry is read and answered by Joel himself.</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--light" href="/contact/">Send an enquiry</a>
      <a class="btn btn--wa" href="{{ site.whatsapp | whatsappHref(site.whatsappMessage) }}" target="_blank" rel="noopener">{{ icon("whatsapp") }} WhatsApp Joel</a>
      <a class="cta__phone" href="{{ site.phone | telHref }}">or call {{ site.phone }}</a>
    </div>
  </div>
</section>
