# Joel Dyter: Apache settings for Armour Hosting

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.joeldyter.co.uk%{REQUEST_URI} [L,R=301]

  # Old Wix pages -> new pages (permanent)
  RewriteRule ^matrix2/?$ /projects/ [L,R=301]
  RewriteRule ^services/?$ /reviews/ [L,R=301]
  RewriteRule ^the_story/?$ /about/ [L,R=301]
  RewriteRule ^contact$ /contact/ [L,R=301]

  # The config file holds email settings: never serve it
  RewriteRule ^enquiry-config\.php$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml
</IfModule>

# Allow photo uploads on the enquiry form (cPanel may override these in MultiPHP INI Editor)
<IfModule mod_php.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 24M
</IfModule>
